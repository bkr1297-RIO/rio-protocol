{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://one-rio-muss.org/schemas/htp-vl/0.1/harmonic-transition-verdict.schema.json",
  "title":"HarmonicTransitionVerdict",
  "type":"object","additionalProperties":false,
  "required":["object_type","protocol_version","verdict_id","proposal_id","proposal_hash","evaluated_at","status","invariant_results","authorized_next_beat"],
  "properties":{
    "object_type":{"const":"HarmonicTransitionVerdict"},
    "protocol_version":{"const":"HTP/VL-1.0"},
    "verdict_id":{"$ref":"common.schema.json#/$defs/id"},
    "proposal_id":{"$ref":"common.schema.json#/$defs/id"},
    "proposal_hash":{"$ref":"common.schema.json#/$defs/hash"},
    "evaluated_at":{"$ref":"common.schema.json#/$defs/timestamp"},
    "status":{"enum":["PASS","HOLD","REFUSE","INVALID"]},
    "expected_cadence":{"enum":["AUTHENTIC","RESTORATIVE","REFUSED","INTERRUPTED","UNSETTLED"]},
    "invariant_results":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["invariant_id","status"],"properties":{"invariant_id":{"$ref":"common.schema.json#/$defs/id"},"status":{"enum":["PASS","FAIL","NOT_APPLICABLE"]},"observed":{},"required_value":{},"evidence_refs":{"type":"array","items":{"$ref":"common.schema.json#/$defs/uriOrId"}}}}},
    "authorization":{"type":"object","additionalProperties":false,"required":["nonce","expires_at","max_executions","scope_hash"],"properties":{"nonce":{"$ref":"common.schema.json#/$defs/id"},"expires_at":{"$ref":"common.schema.json#/$defs/timestamp"},"max_executions":{"type":"integer","minimum":1,"maximum":100},"scope_hash":{"$ref":"common.schema.json#/$defs/hash"},"arguments_hash":{"$ref":"common.schema.json#/$defs/hash"},"authorized_displacement":{"type":"number","minimum":0}}},
    "authorized_next_beat":{"enum":[2,3]},
    "errors":{"type":"array","items":{"$ref":"common.schema.json#/$defs/error"}},
    "verdict_hash":{"$ref":"common.schema.json#/$defs/hash"},
    "signature":{"$ref":"common.schema.json#/$defs/signature"}
  },
  "allOf":[{"if":{"properties":{"status":{"const":"PASS"}}},"then":{"required":["authorization"],"properties":{"authorized_next_beat":{"const":3}}},"else":{"properties":{"authorized_next_beat":{"const":2}}}}],
  "not":{"anyOf":[{"required":["actual_cadence"]},{"required":["execution_status"]},{"required":["consequence"]}]}
}
