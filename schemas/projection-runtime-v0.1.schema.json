        "command",
        "previous_event_ref",
        "created_at",
        "attestation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "CONSTITUTED"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "lifecycle": {
                    "const": "CONSTITUTED"
                  },
                  "from_lifecycle": {
                    "const": "UNCONSTITUTED"
                  },
                  "carriage_authority": {
                    "const": "NONE"
                  }
                },
                "required": [
                  "lifecycle",
                  "from_lifecycle",
                  "carriage_authority"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "CARRIED"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "lifecycle": {
                    "enum": [
                      "CONSTITUTED",
                      "RETURNED",
                      "EXPIRED"
                    ]
                  },
                  "from_lifecycle": {
                    "const": "UNCONSTITUTED"
                  },
                  "carriage_authority": {
                    "const": "NONE"
                  }
                },
                "required": [
                  "lifecycle",
                  "from_lifecycle",
                  "carriage_authority"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "DELEGATED"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "lifecycle": {
                    "const": "DELEGATED"
                  },
                  "grant_id": {
                    "type": "string",
                    "minLength": 16
                  },
                  "authority_envelope": {
                    "type": "object"
                  },
                  "signed_grant": {
                    "type": "object",
                    "properties": {
                      "body": {
                        "type": "object"
                      },
                      "signature": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{128}$"
                      }
                    },
                    "required": [
                      "body",
                      "signature"
                    ],
                    "additionalProperties": false
                  },
                  "predecessor_delegation_ref": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "lifecycle",
                  "grant_id",
                  "authority_envelope",
                  "signed_grant",
                  "predecessor_delegation_ref"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "HOST_ADMISSION"
