        "operation": {
          "enum": [
            "CONSTITUTED",
            "CARRIED",
            "DELEGATED",
            "HOST_ADMISSION",
            "BOUND",
            "REBINDING",
            "OPERATING",
            "SUSPENDED",
            "RETURN_ACCOUNT",
            "RETURNED",
            "EXPIRED",
            "RENEWED",
            "RETURN_ACKNOWLEDGED"
